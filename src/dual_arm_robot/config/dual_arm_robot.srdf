  <disable_collisions link1="DP" link2="L_pinky_proximal" reason="Never"/>
  <disable_collisions link1="DP" link2="L_ring_distal" reason="Never"/>
  <disable_collisions link1="DP" link2="L_ring_proximal" reason="Never"/>
  <disable_collisions link1="DP" link2="L_thumb_distal" reason="Never"/>
  <disable_collisions link1="DP" link2="L_thumb_intermediate" reason="Never"/>
