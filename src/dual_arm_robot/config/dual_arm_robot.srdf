<?xml version="1.0" encoding="UTF-8"?>
<robot name="dual_arm_robot">

  <!-- ==================== GROUPS ==================== -->

  <!-- Left Arm -->
  <group name="left_arm">
    <chain base_link="arm_base_link_l" tip_link="tcp_l"/>
  </group>

  <!-- Right Arm -->
  <group name="right_arm">
    <chain base_link="arm_base_link_r" tip_link="tcp_r"/>
  </group>

  <!-- Dual Arm (both arms) -->
  <group name="dual_arm">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <!-- ==================== GROUP STATES ==================== -->

  <group_state name="home" group="left_arm">
    <joint name="arm_J1_l" value="0"/>
    <joint name="arm_J2_l" value="0"/>
    <joint name="arm_J3_l" value="0"/>
    <joint name="arm_J4_l" value="0"/>
    <joint name="arm_J5_l" value="0"/>
    <joint name="arm_J6_l" value="0"/>
    <joint name="arm_J7_l" value="0"/>
  </group_state>

  <group_state name="home" group="right_arm">
    <joint name="arm_J1_r" value="0"/>
    <joint name="arm_J2_r" value="0"/>
    <joint name="arm_J3_r" value="0"/>
    <joint name="arm_J4_r" value="0"/>
    <joint name="arm_J5_r" value="0"/>
    <joint name="arm_J6_r" value="0"/>
    <joint name="arm_J7_r" value="0"/>
  </group_state>

  <!-- ==================== VIRTUAL JOINT ==================== -->
  <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <!-- ==================== DISABLE COLLISIONS ==================== -->
  <!-- Disable self-collisions between adjacent or fixed links to optimize collision checking -->
  <disable_collisions link1="DP" link2="L_index_distal" reason="Never"/>
  <disable_collisions link1="DP" link2="L_index_proximal" reason="Never"/>
  <disable_collisions link1="DP" link2="L_middle_distal" reason="Never"/>
  <disable_collisions link1="DP" link2="L_middle_proximal" reason="Never"/>
