<?xml version="1.0" encoding="utf-8"?>
<robot name="arm_left" xmlns:xacro="http://ros.org/wiki/xacro">
	<xacro:macro name="arm_left_macro" params="base_link end_effector_link prefix suffix meshdir origin_roll origin_pitch origin_yaw origin_x origin_y origin_z">
        <xacro:property name="origin_x_list" value="${str(origin_x).split(',')}" />
        <xacro:property name="origin_y_list" value="${str(origin_y).split(',')}" />
        <xacro:property name="origin_z_list" value="${str(origin_z).split(',')}" />
        <xacro:property name="origin_roll_list" value="${str(origin_roll).split(',')}" />
        <xacro:property name="origin_pitch_list" value="${str(origin_pitch).split(',')}" />
        <xacro:property name="origin_yaw_list" value="${str(origin_yaw).split(',')}" />
		<link name="${prefix}_${base_link}_${suffix}" />
		<link name="${prefix}_L1_${suffix}">
			<inertial>
				<origin
					xyz="-2.6346E-05 0.0078457 -0.015019"
					rpy="0 0 0" />
				<mass
					value="1.8018" />
				<inertia
					ixx="0.0012538"
					ixy="-1.9834E-06"
					ixz="-5.2622E-07"
					iyy="0.0012637"
					iyz="-2.9121E-05"
					izz="0.0012962" />
			</inertial>
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry>
					<mesh filename="${meshdir}/z1.STL" />
				</geometry>
				<material name="">
					<color rgba="0.75294 0.75294 0.75294 1" />
				</material>
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry>
					<mesh filename="${meshdir}/z1.STL" />
				</geometry>
			</collision>
		</link>
		<joint name="${prefix}_J1_${suffix}" type="revolute">
			<origin xyz="${origin_x_list[0]} ${origin_y_list[0]} ${origin_z_list[0]}" rpy="${origin_roll_list[0]} ${origin_pitch_list[0]} ${origin_yaw_list[0]}" />
			<parent link="${prefix}_${base_link}_${suffix}" />
			<child link="${prefix}_L1_${suffix}" />
			<axis xyz="0 0 1" />
			<limit effort="0" velocity="5.0" lower="-6.28319" upper="6.28319" />
		</joint>
		<link name="${prefix}_L2_${suffix}">
			<inertial>
				<origin
					xyz="-0.00162680449849875 -0.0184910039651903 0.0136168777171135"
