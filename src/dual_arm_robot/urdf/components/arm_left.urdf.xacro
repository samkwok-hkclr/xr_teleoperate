		<link name="${prefix}_${end_effector_link}_${suffix}">
		</link>
		<joint name="${prefix}_J8_${suffix}" type="fixed">
			<origin xyz="0.045 0 0" rpy="0 0 0" />
			<parent link="${prefix}_L7_${suffix}" />
