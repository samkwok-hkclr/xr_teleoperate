				<origin
					xyz="-7.95930562576055E-05 -0.0209081888775424 -0.00839273201372635"
					rpy="0 0 0" />
				<mass
					value="1.29895883494625" />
				<inertia
					ixx="0.00236794137161359"
					ixy="1.41094009131354E-06"
					ixz="3.26441824470034E-06"
					iyy="0.000772004438480909"
