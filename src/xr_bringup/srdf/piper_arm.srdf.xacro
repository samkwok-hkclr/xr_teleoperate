<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper_arm">

  <!-- <xacro:macro name="piper_arm" params="prefix"> -->
    <!--
      Defines:
        - the `manipulator` planning group (kinematic chain base_link -> link6),
        - named group states (`home`, `ready`),
        - virtual joint anchoring the arm to `world`,
        - adjacent-link self-collision exclusions.
    -->

  <group name="left_arm">
    <chain base_link="base_link" tip_link="tcp"/>
  </group>

  <!-- All joints zero. Matches the `piper_go_zero` / `setGripperZero` reference pose. -->
  <group_state name="home" group="left_arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <!-- A small pose that lifts the elbow up off the home pose, useful for safe motion start. -->
  <group_state name="ready" group="left_arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0.5"/>
    <joint name="joint3" value="-0.8"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0.4"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <!-- Anchor the arm base to the world frame so MoveIt has a fixed planning frame. -->
  <!-- <virtual_joint name="piper_arm_base_link" type="fixed" parent_frame="base_link" child_link="piper_arm_base_link"/> -->
  <!-- <virtual_joint name="world_joint" type="fixed"
              parent_frame="world"
              child_link="base_footprint"/> -->
  <!-- Disable collision checking between adjacent links. Adjacent meshes always overlap
      slightly at the joint, so leaving them enabled would deadlock the planner. -->

  <disable_collisions link1="base_footprint"       link2="base_link"                 reason="Adjacent"/>
  <disable_collisions link1="base_link"            link2="piper_arm_base_link"       reason="Adjacent"/>

  <disable_collisions link1="piper_arm_base_link"  link2="piper_arm_link1"           reason="Adjacent"/>
  <disable_collisions link1="piper_arm_link1"      link2="piper_arm_link2"           reason="Adjacent"/>
  <disable_collisions link1="piper_arm_link2"      link2="piper_arm_link3"           reason="Adjacent"/>
  <disable_collisions link1="piper_arm_link3"      link2="piper_arm_link4"           reason="Adjacent"/>
  <disable_collisions link1="piper_arm_link4"      link2="piper_arm_link5"           reason="Adjacent"/>
  <disable_collisions link1="piper_arm_link5"      link2="piper_arm_link6"           reason="Adjacent"/>

   <!-- eef  -->
  <disable_collisions link1="piper_arm_link6"      link2="eef_coupler_link"          reason="Adjacent"/>
  <disable_collisions link1="eef_coupler_link"     link2="eef_coupler_plane_link"    reason="Adjacent"/>
  <disable_collisions link1="eef_coupler_link"     link2="eef_camera_base_link"      reason="Adjacent"/>
  <disable_collisions link1="eef_coupler_link"     link2="suction_cup_link"          reason="Adjacent"/>
  <disable_collisions link1="eef_coupler_link"     link2="tcp"                       reason="Adjacent"/>

  <!-- d435 -->
  <disable_collisions link1="eef_camera_base_link" link2="left_camera_bottom_screw_frame" reason="Adjacent"/>
  <disable_collisions link1="left_camera_bottom_screw_frame" link2="left_camera_link" reason="Adjacent"/>

  <!-- TCP -->
  <disable_collisions link1="tcp"                  link2="tcp_l"                     reason="Adjacent"/>

  <!-- ============================================================ -->
  <!-- Cross-chain "always adjacent" pairs                           -->
  <!-- ============================================================ -->
  <disable_collisions link1="piper_arm_link6"      link2="tcp"                       reason="Adjacent"/>
  <disable_collisions link1="piper_arm_link6"      link2="tcp_l"                     reason="Adjacent"/>
  <disable_collisions link1="piper_arm_link6"      link2="eef_coupler_plane_link"    reason="Adjacent"/>
  <disable_collisions link1="piper_arm_link6"      link2="eef_camera_base_link"      reason="Adjacent"/>
  <disable_collisions link1="piper_arm_link6"      link2="suction_cup_link"          reason="Adjacent"/>

  <disable_collisions link1="eef_coupler_link"     link2="tcp_l"                     reason="Adjacent"/>
  <disable_collisions link1="eef_coupler_link"     link2="left_camera_link"          reason="Adjacent"/>
  <disable_collisions link1="eef_camera_base_link" link2="tcp"                       reason="Adjacent"/>
  <disable_collisions link1="suction_cup_link"     link2="tcp"                       reason="Adjacent"/>
  <disable_collisions link1="suction_cup_link"     link2="tcp_l"                     reason="Adjacent"/>
  

</robot>
